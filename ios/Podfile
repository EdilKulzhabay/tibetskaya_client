# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Для поддержки Firebase
use_frameworks! :linkage => :static

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'tibetskayaClientApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26: поды со старым IPHONEOS_DEPLOYMENT_TARGET (9.0, 11.0) ломают архивацию —
    # выравниваем на минимальную версию, которую задаёт текущая версия RN.
    min_ios = min_ios_version_supported.to_s
    projects = [installer.pods_project]
    if installer.respond_to?(:generated_projects)
      projects.concat(installer.generated_projects)
    end
    projects.compact.uniq.each do |project|
      project.build_configurations.each do |cfg|
        cfg.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = min_ios
      end
      project.targets.each do |target|
        target.build_configurations.each do |cfg|
          cfg.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = min_ios
        end
      end
    end

    # Xcode 26 (Apple clang 21): fmt 11.0.2 вычисляет FMT_USE_CONSTEVAL через безусловный
    # #define (не #ifndef), поэтому внешний -DFMT_USE_CONSTEVAL=0 игнорируется — заголовок
    # сам его переопределяет в 1 для любого clang >= 14 / с __cpp_consteval. Новый clang не
    # может посчитать некоторые её consteval-конструкторы constant expression ("call to
    # consteval function ... is not a constant expression" в format-inl.h). Патчим сам
    # заголовок после каждого pod install — идемпотентно, безопасно перезапускать.
    fmt_base_h = File.join(installer.sandbox.pod_dir("fmt").to_s, "include", "fmt", "base.h")
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      patched = content.gsub(/#\s*define FMT_USE_CONSTEVAL 1\b/, "#define FMT_USE_CONSTEVAL 0")
      if patched != content
        File.chmod(0644, fmt_base_h)
        File.write(fmt_base_h, patched)
        Pod::UI.puts "Patched fmt/include/fmt/base.h: forced FMT_USE_CONSTEVAL=0".green
      end
    end
  end
end
