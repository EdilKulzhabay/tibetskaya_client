<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Красная подложка под прозрачные углы макета иконки -->
    <item>
        <color android:color="#f91718" />
    </item>
    <!-- Логотип по центру, ширина ≈ 50% экрана (см. values*/dimens.xml), без растягивания -->
    <item
        android:width="@dimen/splash_logo_size"
        android:height="@dimen/splash_logo_size"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_screen_logo" />
    </item>
</layer-list>
